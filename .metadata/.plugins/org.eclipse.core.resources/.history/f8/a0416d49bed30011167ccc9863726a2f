package AREA67.proyecto;

import com.badlogic.gdx.ApplicationAdapter;
import com.badlogic.gdx.graphics.g2d.BitmapFont;
import com.badlogic.gdx.Gdx;
import com.badlogic.gdx.assets.AssetManager;
import com.badlogic.gdx.graphics.Texture;
import com.badlogic.gdx.graphics.g2d.SpriteBatch;
import com.badlogic.gdx.graphics.g2d.TextureRegion;
import com.badlogic.gdx.graphics.g2d.Animation;
import com.badlogic.gdx.utils.ScreenUtils;
import com.badlogic.gdx.Input;
import com.badlogic.gdx.graphics.OrthographicCamera;
import com.badlogic.gdx.math.MathUtils;
import com.badlogic.gdx.utils.Array;
import com.badlogic.gdx.graphics.glutils.ShapeRenderer;
import com.badlogic.gdx.graphics.Color;
import com.badlogic.gdx.math.Vector2; // NUEVO: Para calcular colisiones

public class Principal extends ApplicationAdapter {
    private SpriteBatch batch;
    private ShapeRenderer shapeRenderer;
    private Texture image;
    public AssetManager manager;
    private OrthographicCamera camera;
    private float pjX;
    private float pjY;
    private float tiempoJuego;
    private BitmapFont fuenteSurvival;

    private Texture texturaGema;
    private BitmapFont fuenteTexto;
    // VARIABLES JUGADOR
    private Texture sheetSoldado; 
    private Animation<TextureRegion> animacionCaminar;
    private TextureRegion frameEstatico;
    private float stateTime; 
    private Personaje jugador;
    private boolean mirandoDerecha;
    private Array<bala> listaBalas = new Array<>();
    private Texture texturaBala ;

    // VARIABLES ENEMIGOS 
    private Array<enemigos> listaEnemigos;
    private Texture sheetEnemigo; 
    private TextureRegion[] framesEnemigo;
    private float temporizadorSpawneo; 

   private Array<ObjetoSuelo> listaObjetosSuelo = new Array<>();
    @Override
    public void create() {
        batch = new SpriteBatch();
        shapeRenderer = new ShapeRenderer();
        image = new Texture("mapa.jpg");
        manager = new AssetManager();
        camera = new OrthographicCamera();
        tiempoJuego = 0f;
        fuenteSurvival = new BitmapFont();
        fuenteSurvival.getData().setScale(1.5f);
        camera.setToOrtho(false, 800, 600);
        pjX = 400;
        pjY = 300;
        mirandoDerecha = true;
        texturaGema = new Texture("logo.png"); // (Asegúrate de tener la imagen en tu carpeta assets)
        jugador=new Personaje();
        fuenteTexto = new BitmapFont();
        texturaBala = new Texture("tilin.png");
        
        // 1. Carga segura del Soldado
        sheetSoldado = new Texture(Gdx.files.internal("donpollo_izquierda.png"));
        int anchoSoldado = sheetSoldado.getWidth() / 3;
        TextureRegion[][] matrizCortes = TextureRegion.split(sheetSoldado, anchoSoldado, sheetSoldado.getHeight());

        TextureRegion[] framesCaminar = new TextureRegion[3];
        for (int i = 0; i < 3; i++) {
            framesCaminar[i] = matrizCortes[0][i];
        }

        frameEstatico = framesCaminar[0];
        animacionCaminar = new Animation<TextureRegion>(0.15f, framesCaminar);
        stateTime = 0f;

        // 2. Carga segura del Zombi (Automática según lo que mida la imagen)
        sheetEnemigo = new Texture(Gdx.files.internal("zombieverdeizq.png")); 
        TextureRegion[][] matrizCortesEnemigo = TextureRegion.split(sheetEnemigo, 60, 60);
        
        // Calculamos cuántos cuadros de 60x60 tiene la imagen para no pasarnos del límite
        int cantFramesZombi = sheetEnemigo.getWidth() / 60;
        framesEnemigo = new TextureRegion[cantFramesZombi];
        for(int i = 0; i < cantFramesZombi; i++){
            framesEnemigo[i] = matrizCortesEnemigo[0][i];
        }

        // 3. Sistema
        listaEnemigos = new Array<>(); 
        temporizadorSpawneo = 0f;

        jugador.arsenal[0] = new Fusil(texturaBala);
        
    }
        boolean yaMurio=false;

    @Override
    public void render() {
        float deltaTime = Gdx.graphics.getDeltaTime();
        float speed = Personaje.velocidadMovimiento * deltaTime;
        
        tiempoJuego += deltaTime;	
        // LÓGICA DE MOVIMIENTO JUGADOR
        boolean seEstaMoviendo = false;

        if (Gdx.input.isKeyPressed(Input.Keys.W)) { pjY += speed; seEstaMoviendo = true; }
        if (Gdx.input.isKeyPressed(Input.Keys.S)) { pjY -= speed; seEstaMoviendo = true; }
        if (Gdx.input.isKeyPressed(Input.Keys.A)) { pjX -= speed; seEstaMoviendo = true; mirandoDerecha = false; }
        if (Gdx.input.isKeyPressed(Input.Keys.D)) { pjX += speed; seEstaMoviendo = true; mirandoDerecha = true; }
        

        TextureRegion frameActual;
        if (seEstaMoviendo) {
            frameActual = animacionCaminar.getKeyFrame(stateTime, true);
        } else {
            frameActual = frameEstatico;
        }

        if (mirandoDerecha && frameActual.isFlipX()) {
            frameActual.flip(true, false);
        } else if (!mirandoDerecha && !frameActual.isFlipX()) {
            frameActual.flip(true, false);
        }

        // LÓGICA ENEMIGOS Y COLISIONES
        temporizadorSpawneo += deltaTime;
        
        float centroPjX = pjX + (frameActual.getRegionWidth() / 2f);
        float centroPjY = pjY + (frameActual.getRegionHeight() / 2f);
        
        float objetivoX = centroPjX - (framesEnemigo[0].getRegionWidth() / 2f);
        float objetivoY = centroPjY - (framesEnemigo[0].getRegionHeight() / 2f);

        if (jugador != null) {
            jugador.actualizar(deltaTime, centroPjX, centroPjY, listaEnemigos, listaBalas);
        }
        
        if (temporizadorSpawneo > 1.5f) {
            listaEnemigos.add(new enemigos(framesEnemigo, centroPjX, centroPjY));
            temporizadorSpawneo = 0f; 
        }
        if (jugador != null && jugador.arsenal != null) {
            for (Arma arma : jugador.arsenal) {
                if (arma != null) {
                    // ¡Asegúrate de pasar los 5 argumentos aquí!
                    arma.actualizar(deltaTime, centroPjX, centroPjY, listaEnemigos, listaBalas);
                }
            }
        }
        
        for (int i = listaBalas.size - 1; i >= 0; i--) {
            bala bala = listaBalas.get(i);
            bala.actualizar(deltaTime);
            if (!bala.estaActiva()) continue; // Si la bala ya no está activa, la ignoramos

            boolean balaImpactada = false;

            for (int j = listaEnemigos.size - 1; j >= 0; j--) {
                enemigos enemigo = listaEnemigos.get(j);
                
                // Verificamos si el rectángulo de la bala se cruza con el del zombi
                if (bala.getBounds().overlaps(enemigo.getBounds())) {
                    
                    // 1. EL ZOMBI RECIBE DAÑO
                    enemigo.recibirDano(bala.getDano());
                    
                    // 2. LA BALA SE DESACTIVA / MARCA PARA ELIMINARSE
                    balaImpactada = true;
                    
                    break; // Rompemos el bucle de enemigos porque esta bala ya chocó y no puede golpear a otro
                }
            }
            
            // Si la bala impactó a un enemigo, la borramos de la lista para que desaparezca visualmente
            if (balaImpactada) {
                listaBalas.removeIndex(i);
            }
        }
        
        for (int i = listaEnemigos.size - 1; i >= 0; i--) {
            enemigos enemigo = listaEnemigos.get(i);
            enemigo.perseguir(objetivoX, objetivoY, deltaTime);
            
            // NUEVO: Comprobar colisión. Si el zombi está a menos de 45 píxeles de tu centro, te daña.
            float centroZombiX = enemigo.getX() + (framesEnemigo[0].getRegionWidth() / 2f);
            float centroZombiY = enemigo.getY() + (framesEnemigo[0].getRegionHeight() / 2f);
            
            float distancia = Vector2.dst(centroPjX, centroPjY, centroZombiX, centroZombiY);
           
            if (enemigo.estaMuerto()) { // O si su vida llega a 0 por un ataque de arma
                
                // 1. Calculamos el centro del zombi para que la gema nazca ahí
                float centroZombiX1 = enemigo.getX() + (framesEnemigo[0].getRegionWidth() / 2f);
                float centroZombiY1 = enemigo.getY() + (framesEnemigo[0].getRegionHeight() / 2f);
                
                float gemaX = centroZombiX1 - (texturaGema.getWidth() / 2f);
                float gemaY = centroZombiY1 - (texturaGema.getHeight() / 2f);

                // 2. ¡AQUÍ SÍ! Creamos la gema en el suelo porque el zombi acaba de morir
                listaObjetosSuelo.add(new ObjetoSuelo(gemaX, gemaY, "GEMA_EXPERIENCIA", 15));
                
                // 3. Eliminamos al enemigo de la lista para que desaparezca
                listaEnemigos.removeIndex(i);
                continue;
            }
           
            if (distancia < 45f) {
                // Llama a tu clase GestorVida. Los I-Frames evitarán que te mate de un solo golpe.
               jugador.recibirDano(10); 
            }
        }
        
        /*prueba
        for (int i = listaEnemigos.size - 1; i >= 0; i--) {
            enemigos enemigo = listaEnemigos.get(i);
            
            enemigo.perseguir(objetivoX, objetivoY, deltaTime);
            
            float centroZombiX = enemigo.getX() + (framesEnemigo[0].getRegionWidth() / 2f);
            float centroZombiY = enemigo.getY() + (framesEnemigo[0].getRegionHeight() / 2f);
            
            float distancia = Vector2.dst(centroPjX, centroPjY, centroZombiX, centroZombiY);
           
            // Si el zombi está a menos de 45 píxeles, ¡muere instantáneamente!
            if (distancia < 45f) {
                enemigo.recibirDano(100); // O un golpe letal que vacíe su vida
            }
            if (enemigo.estaMuerto()) {
                float gemaX = centroZombiX - (texturaGema.getWidth() / 2f);
                float gemaY = centroZombiY - (texturaGema.getHeight() / 2f);

                listaObjetosSuelo.add(new ObjetoSuelo(gemaX, gemaY, "GEMA_EXPERIENCIA", 15));
                listaEnemigos.removeIndex(i);}
        }
         */
        
        for (Arma arma : jugador.arsenal) {
            if (arma != null) {
                arma.actualizar(deltaTime, centroPjX, centroPjY, listaEnemigos, listaBalas);
            }
        }
       
        if (jugador.estaMuerto()) {
            
			if (!yaMurio) {
                // Este bloque de código SE EJECUTARÁ UNA SOLA VEZ
                System.out.println("¡Game Over!");
                
                yaMurio = true; // Cambiamos la bandera para que nunca vuelva a entrar aquí
            }
            return; // Detiene la ejecución del render para que el juego se "congele"
        }
        
        if (seEstaMoviendo) {
            stateTime += deltaTime;
        } else {
            stateTime = 0f; 
        }
        
        // CÁMARA
        pjX = MathUtils.clamp(pjX, 0, image.getWidth() - frameActual.getRegionWidth());
        pjY = MathUtils.clamp(pjY, 0, image.getHeight() - frameActual.getRegionHeight());

        camera.position.x = pjX + (frameActual.getRegionWidth() / 2f);
        camera.position.y = pjY + (frameActual.getRegionHeight() / 2f);

        float halfCameraWidth = camera.viewportWidth / 2f;
        float halfCameraHeight = camera.viewportHeight / 2f;
        
        camera.position.x = MathUtils.clamp(camera.position.x, halfCameraWidth, image.getWidth() - halfCameraWidth);
        camera.position.y = MathUtils.clamp(camera.position.y, halfCameraHeight, image.getHeight() - halfCameraHeight);

        camera.update();

        // DIBUJO DE TEXTURAS (Batch)
        ScreenUtils.clear(0.15f, 0.15f, 0.2f, 1f);
        batch.setProjectionMatrix(camera.combined);
        batch.begin();
         batch.draw(image, 0, 0); 
      // --- LÓGICA Y DIBUJO DE OBJETOS EN EL SUELO EN UN SOLO BUCLE ---
         for (int i = listaObjetosSuelo.size - 1; i >= 0; i--) {
             ObjetoSuelo objeto = listaObjetosSuelo.get(i);
             
             // 1. El recolector atrae el objeto si está dentro del radio del imán
             jugador.getRecolector().actualizarObjeto(objeto, deltaTime, centroPjX, centroPjY);
             
             // 2. Calculamos la distancia exacta entre el jugador y la gema
             float distanciaAlJugador = Vector2.dst(centroPjX, centroPjY, objeto.getX(), objeto.getY());
             
             // 3. Si la gema está a menos de 40 píxeles, ¡se absorbe!
             if (distanciaAlJugador < jugador.getRecolector().getRangoIman()) {
                 // Sumamos la experiencia al gestor del jugador
                 jugador.getGestorExperiencia().sumarExperiencia(objeto.getValor());
                 
                 // Eliminamos la gema de la lista inmediatamente
                 listaObjetosSuelo.removeIndex(i);
                 
                 // Pasamos a la siguiente gema sin intentar dibujar esta
                 continue; 
             }
             
             // 4. Si aún no ha sido recogida, la dibujamos en pantalla
             batch.draw(texturaGema, objeto.getX(), objeto.getY());
         }
       
        for (enemigos enemigo : listaEnemigos) {
            enemigo.dibujar(batch);
        }
       
     // Convertimos el tiempo total en formato de minutos y segundos
        int minutos = (int) (tiempoJuego / 60);
        int segundos = (int) (tiempoJuego % 60);
        String textoTiempo = String.format("TIEMPO: %02d:%02d", minutos, segundos);

        // Posición fija en la esquina superior izquierda respecto a la cámara
        float textoX = camera.position.x - 380f; 
        float textoY = camera.position.y + 270f; 

        // BORDE NEGRO GRUESO (Simulado duplicando el texto en cruz y diagonales)
        fuenteSurvival.setColor(Color.BLACK);
        fuenteSurvival.draw(batch, textoTiempo, textoX - 2, textoY);
        fuenteSurvival.draw(batch, textoTiempo, textoX + 2, textoY);
        fuenteSurvival.draw(batch, textoTiempo, textoX, textoY - 2);
        fuenteSurvival.draw(batch, textoTiempo, textoX, textoY + 2);
        fuenteSurvival.draw(batch, textoTiempo, textoX - 2, textoY - 2);
        fuenteSurvival.draw(batch, textoTiempo, textoX + 2, textoY + 2);

        // TEXTO PRINCIPAL EN COLOR AMARILLO/BLANCO ARCADE (Ideal para estilo retro/survival)
        fuenteSurvival.setColor(Color.YELLOW); // O puedes usar Color.WHITE según prefieras
        fuenteSurvival.draw(batch, textoTiempo, textoX, textoY);

        batch.draw(frameActual, pjX, pjY); 
        
        int nivel = jugador.getGestorExperiencia().getNivelActual();



     // 3. Dibujar el texto en pantalla
     if (jugador != null && jugador.getGestorExperiencia() != null && fuenteTexto != null) {
    	     nivel = jugador.getGestorExperiencia().getNivelActual();
    	    
    	    // Calculamos la esquina inferior derecha basándonos en dónde está mirando la cámara
    	    float pantallaX = (camera.position.x - (camera.viewportWidth / 2f)) + camera.viewportWidth - 120f;
    	    float pantallaY = (camera.position.y - (camera.viewportHeight / 2f)) + 50f;
    	    
    	    fuenteTexto.draw(batch, "NIVEL: " + nivel, pantallaX, pantallaY);}
        
     for (bala bala : listaBalas) {
    	    bala.dibujar(batch);
    	}
        batch.end(); 

        
        
        // DIBUJO DE BARRA DE VIDA (ShapeRenderer)
        shapeRenderer.setProjectionMatrix(camera.combined);
        shapeRenderer.begin(ShapeRenderer.ShapeType.Filled);
        
     // --- COORDENADAS Y TAMAÑO DE LAS BARRAS ---
       
        float anchoMaximo = 50f;
        float offsetY = frameActual.getRegionHeight() + 10f; 
        float altoBarra = 6f;
         float barraX = pjX + (frameActual.getRegionWidth() / 2f) - (anchoMaximo / 2f);
        float barraY = pjY + offsetY;
        float separacion = 14f; // Distancia entre la barra de vida y la de experiencia

        // 1. --- BARRA DE EXPERIENCIA (AMARILLA Y ENCIMA) ---
        float expActual = jugador.getGestorExperiencia().getXpActual();
        float expMax = jugador.getGestorExperiencia().getXpRequeridaActual();
        float porcentajeExp = Math.min(1f, expActual / expMax); // Evita que pase del 100%

        // Fondo de la barra de experiencia (gris oscuro)
        shapeRenderer.setColor(Color.DARK_GRAY);
        shapeRenderer.rect(barraX, barraY + separacion, anchoMaximo, altoBarra);

        // Relleno de la barra de experiencia (AMARILLO)
        shapeRenderer.setColor(Color.YELLOW);
        shapeRenderer.rect(barraX, barraY + separacion, anchoMaximo * porcentajeExp, altoBarra);

        float porcentajeVida = (float) jugador.getSalud().getVidaActual() / jugador.getSalud().getVidaMaxima();  
       // 
        float anchoActual = anchoMaximo * porcentajeVida;



        // Si la vida es mayor a 0, dibuja la vida. Si no, solo el rojo de fondo
        shapeRenderer.setColor(Color.RED);
        shapeRenderer.rect(barraX, barraY, anchoMaximo, altoBarra);

        if (anchoActual > 0) {
            shapeRenderer.setColor(Color.GREEN);
            shapeRenderer.rect(barraX, barraY, anchoActual, altoBarra);
        }
        

     
        shapeRenderer.end();
    }
    
    @Override
    public void dispose() {
        batch.dispose();
        shapeRenderer.dispose();
        image.dispose();
        sheetSoldado.dispose();
        sheetEnemigo.dispose();
        fuenteSurvival.dispose(); // NUEVO: Limpia la fuente de la memoria
    }
}